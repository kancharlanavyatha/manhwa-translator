# Webtoon Translator Server Environment Configuration
# Copy this file to .env and fill in values if needed (DO NOT commit your real .env file)

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=*

# Translation Provider: local_nmt, google_web, gemini, openai
TRANSLATION_PROVIDER=local_nmt
NMT_MODEL_DIR=server/models/nmt_webtoon

# Optional Cloud API Keys (Leave empty for 100% offline local translation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local OCR Settings
OCR_PROVIDER=rapidocr
OCR_REC_MODEL_PATH=server/models/ocr/korean_rec.onnx
OCR_DICT_PATH=server/models/ocr/korean_dict.txt
